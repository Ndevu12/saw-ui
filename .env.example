# GitHub → Settings → Secrets and variables → Actions
# Secrets for the three VERCEL_*_ID / TOKEN keys; Variables for the rest.

# Secret. Vercel → this project → Settings → General → Project ID
VERCEL_PROJECT_ID=

# Secret. Vercel → top-left Hobby/team switcher → Settings → General → Team ID
VERCEL_ORG_ID=

# Secret. Vercel → account menu → Account Settings → Tokens → Create
VERCEL_TOKEN=

# Variable. Vercel → Settings → General → Project Name (name only, not the URL)
VERCEL_PROJECT=

# Variable. Optional. Team/user slug from the dashboard URL
VERCEL_SCOPE=

# Variable. Public origin the refresh job reads /version.json from, with scheme
SITE_URL=
